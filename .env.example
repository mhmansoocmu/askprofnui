# ── LiveAvatar (Option A — live conversational avatar) ───────────────────────
# Get from https://app.liveavatar.com → Settings → API
LIVEAVATAR_API_KEY=

# Your LiveAvatar avatar UUID (NOT a HeyGen video avatar ID)
LIVEAVATAR_AVATAR_ID=

# Set true while testing to avoid using paid credits
LIVEAVATAR_SANDBOX=false

# ── ElevenLabs ───────────────────────────────────────────────────────────────
# Paid plan required for LiveAvatar connector
# https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=

# Default Voice ID from ElevenLabs → Voices
ELEVENLABS_VOICE_ID=

# Agent ID from ElevenLabs → Conversational AI → your agent (agent_...)
ELEVENLABS_AGENT_ID=

# Run `python setup_liveavatar.py` once to generate this
ELEVENLABS_SECRET_ID=

# ── Optional: text chat (Groq + LangGraph) ───────────────────────────────────
GROQ_API_KEY=

# ── CMU AI Gateway (Andrew) — chat + embeddings ───────────────────────────────
# Docs: https://ai-gateway.andrew.cmu.edu
CMU_AI_API_KEY=
CMU_AI_BASE_URL=https://ai-gateway.andrew.cmu.edu
CMU_CHAT_MODEL=gpt-5-nano
CMU_EMBED_MODEL=azure/text-embedding-3-small

# Set true only for one-time admin sync from app startup (not for production)
ADMIN_SYNC_KNOWLEDGE=false
